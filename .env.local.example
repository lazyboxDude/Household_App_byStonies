# Copy to .env.local and fill in your own Supabase project's values
# (Supabase dashboard -> Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# Cloudflare Turnstile site key (public, safe to expose client-side).
# The matching secret key is never used by this app directly — it's entered
# once in the Supabase dashboard under Authentication -> Attack Protection ->
# Enable Captcha Protection, so Supabase Auth verifies the token server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Show the "Google" button on the login screen. Set to true only after the
# Google provider is enabled in Supabase (Authentication -> Sign In / Providers).
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# --- Push reminders for Routinen (optional; the reminder card stays hidden until the public key is set) ---
# Generate a key pair once with:  npx web-push generate-vapid-keys
# Public key: safe to expose client-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# The next four are SERVER-ONLY secrets: set them in Vercel (Project -> Settings -> Environment Variables),
# never with a NEXT_PUBLIC_ prefix and never in the repo.
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com
# Supabase dashboard -> Settings -> API -> service_role key. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <value>" to /api/push/send.
CRON_SECRET=a_long_random_string
