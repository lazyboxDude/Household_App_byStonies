# Copy to .env.local and fill in your own Supabase project's values
# (Supabase dashboard -> Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# Cloudflare Turnstile site key (public, safe to expose client-side).
# The matching secret key is never used by this app directly — it's entered
# once in the Supabase dashboard under Authentication -> Attack Protection ->
# Enable Captcha Protection, so Supabase Auth verifies the token server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
